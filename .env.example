# Copie para .env.local no desenvolvimento. Nunca publique valores reais no Git.
# Na Vercel, configure os valores no painel de variáveis de ambiente.

# Banco externo obrigatório na Vercel: integração Turso/libSQL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sem URL remota, o desenvolvimento usa .data/atelier.sqlite.
# ATELIER_DATABASE_PATH=.data/atelier.sqlite

# Origem HTTPS pública exata, sem caminho. Em desenvolvimento: http://localhost:3000
ATELIER_APP_ORIGIN=

# Código aleatório para cadastrar o primeiro administrador em /equipe.
# O cadastro público em /entrar sempre cria um cliente.
ATELIER_SETUP_TOKEN=

# Envio transacional Resend. MAIL_FROM precisa ser um remetente verificado.
RESEND_API_KEY=
MAIL_FROM=

# No desenvolvimento, mensagens são arquivos privados em .data/mail.
# Em produção, o padrão é resend. Transporte file nunca é usado na Vercel.
# MAIL_TRANSPORT=file
# ATELIER_MAIL_OUTBOX=.data/mail

# Chave de 32 bytes em hexadecimal, guardada fora do Git (64 caracteres).
# Necessária no job de backup e na máquina usada para restaurar.
ATELIER_BACKUP_KEY=
# ATELIER_BACKUP_DIR=.data/backups
