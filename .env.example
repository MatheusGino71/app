# Copie para .env.local no desenvolvimento. Nunca publique valores reais no Git.
# Na Vercel, configure os valores no painel de variáveis de ambiente.

# Banco externo obrigatório na Vercel: integração Turso/libSQL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Sem URL remota, o desenvolvimento usa .data/atelier.sqlite.
# ATELIER_DATABASE_PATH=.data/atelier.sqlite

# Origem HTTPS pública exata, sem caminho. Em desenvolvimento: http://localhost:3000
ATELIER_APP_ORIGIN=

# Código aleatório para cadastrar o primeiro administrador em /equipe.
# O cadastro público está bloqueado; contas da equipe exigem convite.
ATELIER_SETUP_TOKEN=

# Envio transacional Resend. MAIL_FROM precisa ser um remetente verificado.
RESEND_API_KEY=
MAIL_FROM=

# No desenvolvimento, mensagens são arquivos privados em .data/mail.
# Em produção, o padrão é resend. Transporte file nunca é usado na Vercel.
# MAIL_TRANSPORT=file
# ATELIER_MAIL_OUTBOX=.data/mail

# Chave de 32 bytes em hexadecimal, guardada fora do Git (64 caracteres).
# Necessária no job de backup e na máquina usada para restaurar.
ATELIER_BACKUP_KEY=
# ATELIER_BACKUP_DIR=.data/backups

# Chave separada de 32 bytes em hexadecimal para os segredos do autenticador.
# Preserve a mesma chave na recuperação do banco; não a altere com MFA ativo.
ATELIER_MFA_KEY=

# Segredo do agendamento Vercel para limpar apenas credenciais expiradas.
CRON_SECRET=

# Prazo aprovado para listar cadastros comerciais inativos para revisão.
# Não ativa exclusão automática. Deixe vazio até aprovar a política.
ATELIER_RECORD_RETENTION_DAYS=

# Aviso de privacidade: valores públicos, aprovados pelo responsável da empresa.
ATELIER_PRIVACY_CONTROLLER=
ATELIER_PRIVACY_ADDRESS=
ATELIER_PRIVACY_COUNTRY=
ATELIER_PRIVACY_EMAIL=
ATELIER_PRIVACY_LEGAL_BASIS=
ATELIER_PRIVACY_RETENTION_NOTICE=
ATELIER_PRIVACY_DATA_LOCATIONS=
ATELIER_PRIVACY_TRANSFERS=
ATELIER_PRIVACY_AUTHORITY_URL=
ATELIER_PRIVACY_APPROVED=false
