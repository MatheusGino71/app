{
  "name": "grace-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Grace Pro — Commercial intelligence for professional salon teams.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "audit:i18n": "node scripts/audit-i18n.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:http": "node scripts/http-smoke.cjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.cjs",
    "restore": "node --env-file-if-exists=.env.local scripts/backup.cjs restore",
    "preflight": "node --env-file-if-exists=.env.local scripts/preflight.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "lucide-react": "1.31.0",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
